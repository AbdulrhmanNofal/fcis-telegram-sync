# Telegram API Credentials (احصل عليها من https://my.telegram.org)
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here
TG_PHONE=+201xxxxxxxxxx

# اسم أو رابط الكوميونيتي على تليجرام
# مثال: FCISCommunity29 أو الـ ID الرقمي للجروب
TG_COMMUNITY=FCISCommunity29

# حساب الأدمن على FCIS Hub لتسجيل الدخول ورفع الملفات عبر الـ API
FCIS_API_BASE=http://localhost:5000/api
FCIS_ADMIN_EMAIL=admin@fcishub.com
FCIS_ADMIN_PASSWORD=your_admin_password

# حساب تليجرام لاستلام إشعارات بالملفات التي تم رفعها بنجاح (اختياري)
ADMIN_TG_CHAT_ID=

# مفتاح Google Gemini AI لتفعيل عميل الذكاء الاصطناعي للفرز الذكي (اختياري)
# إذا ترك فارغاً سيعمل المحرك الذكي المدمج (Rule Engine) بكفاءة كاملة وسرعة فائقة
GEMINI_API_KEY=
